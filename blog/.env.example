# Preencher no Vercel (Project Settings > Environment Variables) e localmente
# num arquivo .env.local (nunca commitado).

# ID do projeto Sanity (gerado por `npx sanity init` — veja o README).
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset do Sanity. "production" é o padrão criado pelo `sanity init`.
NEXT_PUBLIC_SANITY_DATASET=production

# URL base do blog em produção, usada nas tags canonical/OG.
NEXT_PUBLIC_SITE_URL=https://blog.tremeterraaudiovisual.com.br
