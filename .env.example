# Variáveis de ambiente da Treme Terra Audiovisual.
# Copie este arquivo para .env e preencha com os valores reais:
#   cp .env.example .env
# NUNCA commite o .env real — ele está no .gitignore.
#
# Em produção (Render), estes valores NÃO vêm do .env: são preenchidos no
# painel do Render (Environment). O .env é só conveniência para rodar
# localmente com `npm run serve:php`.

# --- ActiveCampaign (usado por subscribe.php) ---
# Onde achar cada valor no painel do ActiveCampaign:
#   URL / Chave -> Settings > Developer
#   Lista       -> Lists > (a lista) > o ID aparece na URL
#   Campos      -> Settings > Manage Fields > o ID aparece ao editar o campo
ACTIVECAMPAIGN_API_URL=https://SUACONTA.api-us1.com
ACTIVECAMPAIGN_API_KEY=
ACTIVECAMPAIGN_LIST_ID=
ACTIVECAMPAIGN_FIELD_EVENT_TYPE=
ACTIVECAMPAIGN_FIELD_MESSAGE=
ACTIVECAMPAIGN_FIELD_PAGE=

# --- Notificação de leads por e-mail (SMTP, usado por subscribe.php) ---
# A cada formulário enviado, manda um e-mail pra equipe comercial. Sem estas
# variáveis o lead ainda é salvo no banco (/admin/leads.php), só não dispara
# e-mail.
#
# E-mail da Treme Terra = Zoho Mail. Config de SMTP do Zoho:
#   Host: smtp.zoho.com  (data center US/global; se a conta for na Europa use
#         smtp.zoho.eu, na Índia smtp.zoho.in — confira a URL de login do Zoho)
#   Porta 587 (STARTTLS) — ou 465 com SMTP_SECURE=ssl
#   Antes de usar: no Zoho, ative "IMAP/SMTP Access" (Settings > Mail Accounts)
#   e, se a conta tiver verificação em 2 fatores, gere uma "App Password"
#   (Zoho > My Account > Security > App Passwords) e use ela em SMTP_PASS.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=comercial@tremeterraaudiovisual.com.br
SMTP_PASS=
SMTP_SECURE=tls
MAIL_FROM=comercial@tremeterraaudiovisual.com.br
MAIL_FROM_NAME=Site Treme Terra
# Para quem chega a notificação (padrão: comercial@tremeterraaudiovisual.com.br)
LEAD_NOTIFY_EMAIL=comercial@tremeterraaudiovisual.com.br

# --- Blog (opcional) ---
# Caminho do banco SQLite do blog (em produção aponta pro disco persistente).
SQLITE_DB_PATH=
# Hash da senha do admin do blog. Gerar com:
#   php -r "echo password_hash('SUA_SENHA', PASSWORD_DEFAULT);"
ADMIN_PASSWORD_HASH=
